#ifndef _NPY_UMATH_MINMAX_H_
#define _NPY_UMATH_MINMAX_H_

#ifndef NPY_NO_EXPORT
    #define NPY_NO_EXPORT NPY_VISIBILITY_HIDDEN
#endif

#ifdef __cplusplus
extern "C" {
#endif

typedef struct PyArrayMethod_Context_tag PyArrayMethod_Context;
typedef struct NpyAuxData_tag NpyAuxData;

#include "minmax.dispatch.h"

/* SIMD dtypes: forward + reduction loops (defined in minmax.dispatch.c.src) */
/**begin repeat
 * #TYPE = BYTE, UBYTE, SHORT, USHORT, INT, UINT,
 *         LONG, ULONG, LONGLONG, ULONGLONG,
 *         FLOAT, DOUBLE, LONGDOUBLE#
 */
NPY_CPU_DISPATCH_DECLARE(NPY_NO_EXPORT void @TYPE@_minimummaximum,
  (char **args, npy_intp const *dimensions, npy_intp const *steps, void *NPY_UNUSED(data)))
NPY_CPU_DISPATCH_DECLARE(NPY_NO_EXPORT int @TYPE@_minimummaximum_reduce,
  (PyArrayMethod_Context *context, char *const *data, npy_intp const *dimensions,
   npy_intp const *strides, NpyAuxData *auxdata))
/**end repeat**/

/* scalar (non-SIMD) forward loops (defined in minmax.c.src) */
NPY_NO_EXPORT void
BOOL_minimummaximum(char **args, npy_intp const *dimensions, npy_intp const *steps, void *NPY_UNUSED(func));
NPY_NO_EXPORT void
HALF_minimummaximum(char **args, npy_intp const *dimensions, npy_intp const *steps, void *NPY_UNUSED(func));
NPY_NO_EXPORT void
OBJECT_minimummaximum(char **args, npy_intp const *dimensions, npy_intp const *steps, void *NPY_UNUSED(func));

/**begin repeat
 * #TYPE = CFLOAT, CDOUBLE, CLONGDOUBLE, DATETIME, TIMEDELTA#
 */
NPY_NO_EXPORT void
@TYPE@_minimummaximum(char **args, npy_intp const *dimensions, npy_intp const *steps, void *NPY_UNUSED(func));
/**end repeat**/

NPY_NO_EXPORT int
init_minimummaximum(PyObject *umath);

#ifdef __cplusplus
}
#endif

#endif  /* _NPY_UMATH_MINMAX_H_ */
