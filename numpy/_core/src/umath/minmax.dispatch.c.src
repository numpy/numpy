/*
 * SIMD forward and reduction loops for the fused `minimummaximum` ufunc, for
 * the dtypes that `minimum`/`maximum` vectorize (all integers + float32/64/
 * longdouble).  The scalar helpers and the load/unroll structure are copied
 * verbatim from loops_minmax.dispatch.c.src so the fused loops get exactly the
 * same optimizations, sharing the input loads between the min and max.
 *
 * The remaining dtypes (bool, half, complex, datetime, object) and the
 * registration glue live in minmax.c.src.
 */
#define _UMATHMODULE
#define _MULTIARRAYMODULE
#define NPY_NO_DEPRECATED_API NPY_API_VERSION

#include "simd/simd.h"
#include "loops_utils.h"
#include "lowlevel_strided_loops.h"
// Provides the various *_LOOP macros
#include "fast_loop_macros.h"
#include "numpy/npy_math.h"

#include "minmax.h"

/*******************************************************************************
 ** Scalar intrinsics (copied from loops_minmax.dispatch.c.src)
 ******************************************************************************/
// signed/unsigned int
#define scalar_max_i(A, B) ((A > B) ? A : B)
#define scalar_min_i(A, B) ((A < B) ? A : B)
// fp, propagates NaNs
#define scalar_max(A, B) ((A >= B || npy_isnan(A)) ? A : B)
#define scalar_max_f scalar_max
#define scalar_max_d scalar_max
#define scalar_max_l scalar_max
#define scalar_min(A, B) ((A <= B || npy_isnan(A)) ? A : B)
#define scalar_min_f scalar_min
#define scalar_min_d scalar_min
#define scalar_min_l scalar_min

// special optimization for fp scalars propagates NaNs
// since there're no C99 support for it
#ifndef NPY_DISABLE_OPTIMIZATION
/**begin repeat
 * #type = npy_float, npy_double#
 * #sfx = f32, f64#
 * #c_sfx = f, d#
 * #isa_sfx = s, d#
 * #sse_type = __m128, __m128d#
 */
/**begin repeat1
 * #op = max, min#
 * #neon_instr = fmax, fmin#
 */
#ifdef NPY_HAVE_SSE2
#undef scalar_@op@_@c_sfx@
NPY_FINLINE @type@ scalar_@op@_@c_sfx@(@type@ a, @type@ b) {
    @sse_type@ va = _mm_set_s@isa_sfx@(a);
    @sse_type@ vb = _mm_set_s@isa_sfx@(b);
    @sse_type@ rv = _mm_@op@_s@isa_sfx@(va, vb);
    // X86 handle second operand
    @sse_type@ nn = _mm_cmpord_s@isa_sfx@(va, va);
    #ifdef NPY_HAVE_SSE41
    rv = _mm_blendv_p@isa_sfx@(va, rv, nn);
    #else
    rv = _mm_xor_p@isa_sfx@(va, _mm_and_p@isa_sfx@(_mm_xor_p@isa_sfx@(va, rv), nn));
    #endif
    return _mm_cvts@isa_sfx@_@sfx@(rv);
}
#endif // SSE2
#ifdef __aarch64__
#undef scalar_@op@_@c_sfx@
NPY_FINLINE @type@ scalar_@op@_@c_sfx@(@type@ a, @type@ b) {
    @type@ result = 0;
    __asm(
        "@neon_instr@ %@isa_sfx@[result], %@isa_sfx@[a], %@isa_sfx@[b]"
        : [result] "=w" (result)
        : [a] "w" (a), [b] "w" (b)
    );
    return result;
}
#endif // __aarch64__
/**end repeat1**/
/**end repeat**/
#endif // NPY_DISABLE_OPTIMIZATION
// mapping to double if its possible
#if NPY_BITSOF_DOUBLE == NPY_BITSOF_LONGDOUBLE
/**begin repeat
 * #op = max, min#
 */
    #undef scalar_@op@_l
    #define scalar_@op@_l scalar_@op@_d
/**end repeat**/
#endif

/*******************************************************************************
 ** Fused min+max SIMD kernels
 **
 ** These mirror the single-op kernels in loops_minmax.dispatch.c.src (same
 ** unrolling, same intrinsics) but compute the minimum and maximum in a single
 ** pass, sharing the input loads.
 ******************************************************************************/
/**begin repeat
 * #sfx = s8, u8, s16, u16, s32, u32, s64, u64, f32, f64#
 * #simd_chk = NPY_SIMD*8, NPY_SIMD_F32, NPY_SIMD_F64#
 * #is_fp = 0*8, 1, 1#
 * #scalar_sfx = i*8, f, d#
 */
#if @simd_chk@
#if @is_fp@
    #define V_MIN npyv_minn_@sfx@ // propagates NaNs
    #define V_MAX npyv_maxn_@sfx@
    #define V_REDUCE_MIN npyv_reduce_minn_@sfx@
    #define V_REDUCE_MAX npyv_reduce_maxn_@sfx@
#else
    #define V_MIN npyv_min_@sfx@
    #define V_MAX npyv_max_@sfx@
    #define V_REDUCE_MIN npyv_reduce_min_@sfx@
    #define V_REDUCE_MAX npyv_reduce_max_@sfx@
#endif
#define SCALAR_MIN scalar_min_@scalar_sfx@
#define SCALAR_MAX scalar_max_@scalar_sfx@

// contiguous inputs and outputs: op_min = min(ip1, ip2), op_max = max(ip1, ip2)
static inline void
simd_binary_ccc_minmax_@sfx@(const npyv_lanetype_@sfx@ *ip1, const npyv_lanetype_@sfx@ *ip2,
                             npyv_lanetype_@sfx@ *op_min, npyv_lanetype_@sfx@ *op_max, npy_intp len)
{
#if NPY_SIMD_WIDTH == 128
    // Note, 6x unroll was chosen for best results on Apple M1
    const int vectorsPerLoop = 6;
#else
    // To avoid memory bandwidth bottleneck
    const int vectorsPerLoop = 2;
#endif
    const int elemPerVector = npyv_nlanes_@sfx@;
    int elemPerLoop = vectorsPerLoop * elemPerVector;

    npy_intp i = 0;
    for (; (i+elemPerLoop) <= len; i += elemPerLoop) {
        npyv_@sfx@ v0 = npyv_load_@sfx@(&ip1[i + 0 * elemPerVector]);
        npyv_@sfx@ v1 = npyv_load_@sfx@(&ip1[i + 1 * elemPerVector]);
    #if NPY_SIMD_WIDTH == 128
        npyv_@sfx@ v2 = npyv_load_@sfx@(&ip1[i + 2 * elemPerVector]);
        npyv_@sfx@ v3 = npyv_load_@sfx@(&ip1[i + 3 * elemPerVector]);
        npyv_@sfx@ v4 = npyv_load_@sfx@(&ip1[i + 4 * elemPerVector]);
        npyv_@sfx@ v5 = npyv_load_@sfx@(&ip1[i + 5 * elemPerVector]);
    #endif
        npyv_@sfx@ u0 = npyv_load_@sfx@(&ip2[i + 0 * elemPerVector]);
        npyv_@sfx@ u1 = npyv_load_@sfx@(&ip2[i + 1 * elemPerVector]);
    #if NPY_SIMD_WIDTH == 128
        npyv_@sfx@ u2 = npyv_load_@sfx@(&ip2[i + 2 * elemPerVector]);
        npyv_@sfx@ u3 = npyv_load_@sfx@(&ip2[i + 3 * elemPerVector]);
        npyv_@sfx@ u4 = npyv_load_@sfx@(&ip2[i + 4 * elemPerVector]);
        npyv_@sfx@ u5 = npyv_load_@sfx@(&ip2[i + 5 * elemPerVector]);
    #endif
        npyv_store_@sfx@(&op_min[i + 0 * elemPerVector], V_MIN(v0, u0));
        npyv_store_@sfx@(&op_min[i + 1 * elemPerVector], V_MIN(v1, u1));
    #if NPY_SIMD_WIDTH == 128
        npyv_store_@sfx@(&op_min[i + 2 * elemPerVector], V_MIN(v2, u2));
        npyv_store_@sfx@(&op_min[i + 3 * elemPerVector], V_MIN(v3, u3));
        npyv_store_@sfx@(&op_min[i + 4 * elemPerVector], V_MIN(v4, u4));
        npyv_store_@sfx@(&op_min[i + 5 * elemPerVector], V_MIN(v5, u5));
    #endif
        npyv_store_@sfx@(&op_max[i + 0 * elemPerVector], V_MAX(v0, u0));
        npyv_store_@sfx@(&op_max[i + 1 * elemPerVector], V_MAX(v1, u1));
    #if NPY_SIMD_WIDTH == 128
        npyv_store_@sfx@(&op_max[i + 2 * elemPerVector], V_MAX(v2, u2));
        npyv_store_@sfx@(&op_max[i + 3 * elemPerVector], V_MAX(v3, u3));
        npyv_store_@sfx@(&op_max[i + 4 * elemPerVector], V_MAX(v4, u4));
        npyv_store_@sfx@(&op_max[i + 5 * elemPerVector], V_MAX(v5, u5));
    #endif
    }
    for (; (i+elemPerVector) <= len; i += elemPerVector) {
        npyv_@sfx@ v0 = npyv_load_@sfx@(ip1 + i);
        npyv_@sfx@ u0 = npyv_load_@sfx@(ip2 + i);
        npyv_store_@sfx@(op_min + i, V_MIN(v0, u0));
        npyv_store_@sfx@(op_max + i, V_MAX(v0, u0));
    }
    for (; i < len; ++i) {
        const npyv_lanetype_@sfx@ in1 = ip1[i];
        const npyv_lanetype_@sfx@ in2 = ip2[i];
        op_min[i] = SCALAR_MIN(in1, in2);
        op_max[i] = SCALAR_MAX(in1, in2);
    }
}

// contiguous reduction: fold `ip` into scalar accumulators seeded from op_*[0]
static inline void
simd_reduce_c_minmax_@sfx@(const npyv_lanetype_@sfx@ *ip,
                           npyv_lanetype_@sfx@ *op_min, npyv_lanetype_@sfx@ *op_max, npy_intp len)
{
    if (len < 1) {
        return;
    }
    const int vstep = npyv_nlanes_@sfx@;
    const int wstep = vstep*8;
    npyv_@sfx@ acc_min = npyv_setall_@sfx@(op_min[0]);
    npyv_@sfx@ acc_max = npyv_setall_@sfx@(op_max[0]);
    for (; len >= wstep; len -= wstep, ip += wstep) {
    #ifdef NPY_HAVE_SSE2
        NPY_PREFETCH((const char*)(ip + wstep), 0, 3);
    #endif
        // the eight loads are shared between the min-tree and the max-tree
        npyv_@sfx@ v0 = npyv_load_@sfx@(ip + vstep * 0);
        npyv_@sfx@ v1 = npyv_load_@sfx@(ip + vstep * 1);
        npyv_@sfx@ v2 = npyv_load_@sfx@(ip + vstep * 2);
        npyv_@sfx@ v3 = npyv_load_@sfx@(ip + vstep * 3);
        npyv_@sfx@ v4 = npyv_load_@sfx@(ip + vstep * 4);
        npyv_@sfx@ v5 = npyv_load_@sfx@(ip + vstep * 5);
        npyv_@sfx@ v6 = npyv_load_@sfx@(ip + vstep * 6);
        npyv_@sfx@ v7 = npyv_load_@sfx@(ip + vstep * 7);

        npyv_@sfx@ rmin01 = V_MIN(v0, v1);
        npyv_@sfx@ rmin23 = V_MIN(v2, v3);
        npyv_@sfx@ rmin45 = V_MIN(v4, v5);
        npyv_@sfx@ rmin67 = V_MIN(v6, v7);
        acc_min = V_MIN(acc_min, V_MIN(V_MIN(rmin01, rmin23), V_MIN(rmin45, rmin67)));

        npyv_@sfx@ rmax01 = V_MAX(v0, v1);
        npyv_@sfx@ rmax23 = V_MAX(v2, v3);
        npyv_@sfx@ rmax45 = V_MAX(v4, v5);
        npyv_@sfx@ rmax67 = V_MAX(v6, v7);
        acc_max = V_MAX(acc_max, V_MAX(V_MAX(rmax01, rmax23), V_MAX(rmax45, rmax67)));
    }
    for (; len >= vstep; len -= vstep, ip += vstep) {
        npyv_@sfx@ v = npyv_load_@sfx@(ip);
        acc_min = V_MIN(acc_min, v);
        acc_max = V_MAX(acc_max, v);
    }
    npyv_lanetype_@sfx@ rmin = V_REDUCE_MIN(acc_min);
    npyv_lanetype_@sfx@ rmax = V_REDUCE_MAX(acc_max);
    for (; len > 0; --len, ++ip) {
        const npyv_lanetype_@sfx@ v = *ip;
        rmin = SCALAR_MIN(rmin, v);
        rmax = SCALAR_MAX(rmax, v);
    }
    op_min[0] = rmin;
    op_max[0] = rmax;
}

// reduction over an outer axis: the accumulators are contiguous arrays that
// are both read and written each element (io_min/io_max alias the outputs).
static inline void
simd_reduce_outer_minmax_@sfx@(const npyv_lanetype_@sfx@ *ip,
                               npyv_lanetype_@sfx@ *io_min, npyv_lanetype_@sfx@ *io_max, npy_intp len)
{
#if NPY_SIMD_WIDTH == 128
    // Note, 6x unroll was chosen for best results on Apple M1
    const int vectorsPerLoop = 6;
#else
    // To avoid memory bandwidth bottleneck
    const int vectorsPerLoop = 2;
#endif
    const int elemPerVector = npyv_nlanes_@sfx@;
    int elemPerLoop = vectorsPerLoop * elemPerVector;

    npy_intp i = 0;
    for (; (i+elemPerLoop) <= len; i += elemPerLoop) {
        npyv_@sfx@ v0 = npyv_load_@sfx@(&ip[i + 0 * elemPerVector]);
        npyv_@sfx@ v1 = npyv_load_@sfx@(&ip[i + 1 * elemPerVector]);
    #if NPY_SIMD_WIDTH == 128
        npyv_@sfx@ v2 = npyv_load_@sfx@(&ip[i + 2 * elemPerVector]);
        npyv_@sfx@ v3 = npyv_load_@sfx@(&ip[i + 3 * elemPerVector]);
        npyv_@sfx@ v4 = npyv_load_@sfx@(&ip[i + 4 * elemPerVector]);
        npyv_@sfx@ v5 = npyv_load_@sfx@(&ip[i + 5 * elemPerVector]);
    #endif
        npyv_@sfx@ a0 = npyv_load_@sfx@(&io_min[i + 0 * elemPerVector]);
        npyv_@sfx@ a1 = npyv_load_@sfx@(&io_min[i + 1 * elemPerVector]);
    #if NPY_SIMD_WIDTH == 128
        npyv_@sfx@ a2 = npyv_load_@sfx@(&io_min[i + 2 * elemPerVector]);
        npyv_@sfx@ a3 = npyv_load_@sfx@(&io_min[i + 3 * elemPerVector]);
        npyv_@sfx@ a4 = npyv_load_@sfx@(&io_min[i + 4 * elemPerVector]);
        npyv_@sfx@ a5 = npyv_load_@sfx@(&io_min[i + 5 * elemPerVector]);
    #endif
        npyv_store_@sfx@(&io_min[i + 0 * elemPerVector], V_MIN(a0, v0));
        npyv_store_@sfx@(&io_min[i + 1 * elemPerVector], V_MIN(a1, v1));
    #if NPY_SIMD_WIDTH == 128
        npyv_store_@sfx@(&io_min[i + 2 * elemPerVector], V_MIN(a2, v2));
        npyv_store_@sfx@(&io_min[i + 3 * elemPerVector], V_MIN(a3, v3));
        npyv_store_@sfx@(&io_min[i + 4 * elemPerVector], V_MIN(a4, v4));
        npyv_store_@sfx@(&io_min[i + 5 * elemPerVector], V_MIN(a5, v5));
    #endif
        npyv_@sfx@ b0 = npyv_load_@sfx@(&io_max[i + 0 * elemPerVector]);
        npyv_@sfx@ b1 = npyv_load_@sfx@(&io_max[i + 1 * elemPerVector]);
    #if NPY_SIMD_WIDTH == 128
        npyv_@sfx@ b2 = npyv_load_@sfx@(&io_max[i + 2 * elemPerVector]);
        npyv_@sfx@ b3 = npyv_load_@sfx@(&io_max[i + 3 * elemPerVector]);
        npyv_@sfx@ b4 = npyv_load_@sfx@(&io_max[i + 4 * elemPerVector]);
        npyv_@sfx@ b5 = npyv_load_@sfx@(&io_max[i + 5 * elemPerVector]);
    #endif
        npyv_store_@sfx@(&io_max[i + 0 * elemPerVector], V_MAX(b0, v0));
        npyv_store_@sfx@(&io_max[i + 1 * elemPerVector], V_MAX(b1, v1));
    #if NPY_SIMD_WIDTH == 128
        npyv_store_@sfx@(&io_max[i + 2 * elemPerVector], V_MAX(b2, v2));
        npyv_store_@sfx@(&io_max[i + 3 * elemPerVector], V_MAX(b3, v3));
        npyv_store_@sfx@(&io_max[i + 4 * elemPerVector], V_MAX(b4, v4));
        npyv_store_@sfx@(&io_max[i + 5 * elemPerVector], V_MAX(b5, v5));
    #endif
    }
    for (; (i+elemPerVector) <= len; i += elemPerVector) {
        npyv_@sfx@ v = npyv_load_@sfx@(ip + i);
        npyv_store_@sfx@(io_min + i, V_MIN(npyv_load_@sfx@(io_min + i), v));
        npyv_store_@sfx@(io_max + i, V_MAX(npyv_load_@sfx@(io_max + i), v));
    }
    for (; i < len; ++i) {
        const npyv_lanetype_@sfx@ v = ip[i];
        io_min[i] = SCALAR_MIN(io_min[i], v);
        io_max[i] = SCALAR_MAX(io_max[i], v);
    }
}

#undef V_MIN
#undef V_MAX
#undef V_REDUCE_MIN
#undef V_REDUCE_MAX
#undef SCALAR_MIN
#undef SCALAR_MAX
#endif // simd_chk
/**end repeat**/

/*******************************************************************************
 ** Defining ufunc inner functions
 ******************************************************************************/
/**begin repeat
 * #TYPE = UBYTE, USHORT, UINT, ULONG, ULONGLONG,
 *         BYTE, SHORT, INT, LONG, LONGLONG,
 *         FLOAT, DOUBLE, LONGDOUBLE#
 *
 * #BTYPE = BYTE, SHORT, INT,  LONG, LONGLONG,
 *          BYTE, SHORT, INT, LONG, LONGLONG,
 *          FLOAT, DOUBLE, LONGDOUBLE#
 * #type = npy_ubyte, npy_ushort, npy_uint, npy_ulong, npy_ulonglong,
 *         npy_byte, npy_short, npy_int, npy_long, npy_longlong,
 *         npy_float, npy_double, npy_longdouble#
 *
 * #is_fp = 0*10, 1*3#
 * #is_unsigned = 1*5, 0*5, 0*3#
 * #scalar_sfx = i*10, f, d, l#
 */
#undef TO_SIMD_SFX
#if 0
/**begin repeat1
 * #len = 8, 16, 32, 64#
 */
#elif NPY_SIMD && NPY_BITSOF_@BTYPE@ == @len@
    #if @is_fp@
        #define TO_SIMD_SFX(X) X##_f@len@
        #if NPY_BITSOF_@BTYPE@ == 32 && !NPY_SIMD_F32
            #undef TO_SIMD_SFX
        #endif
        #if NPY_BITSOF_@BTYPE@ == 64 && !NPY_SIMD_F64
            #undef TO_SIMD_SFX
        #endif
    #elif @is_unsigned@
        #define TO_SIMD_SFX(X) X##_u@len@
    #else
        #define TO_SIMD_SFX(X) X##_s@len@
    #endif
/**end repeat1**/
#endif

/*
 * Fused `minimummaximum` forward loop: op_min = minimum(ip1, ip2) and
 * op_max = maximum(ip1, ip2) in a single pass.
 */
NPY_NO_EXPORT void NPY_CPU_DISPATCH_CURFX(@TYPE@_minimummaximum)
(char **args, npy_intp const *dimensions, npy_intp const *steps, void *NPY_UNUSED(func))
{
    char *ip1 = args[0], *ip2 = args[1], *op1 = args[2], *op2 = args[3];
    npy_intp is1 = steps[0], is2 = steps[1], os1 = steps[2], os2 = steps[3],
             len = dimensions[0];
    npy_intp i = 0;
#ifdef TO_SIMD_SFX
    #undef STYPE
    #define STYPE TO_SIMD_SFX(npyv_lanetype)
    if (is1 == sizeof(@type@) && is2 == sizeof(@type@) &&
        os1 == sizeof(@type@) && os2 == sizeof(@type@) &&
        !is_mem_overlap(ip1, is1, op1, os1, len) &&
        !is_mem_overlap(ip1, is1, op2, os2, len) &&
        !is_mem_overlap(ip2, is2, op1, os1, len) &&
        !is_mem_overlap(ip2, is2, op2, os2, len)
    ) {
        TO_SIMD_SFX(simd_binary_ccc_minmax)(
            (STYPE*)ip1, (STYPE*)ip2, (STYPE*)op1, (STYPE*)op2, len
        );
        goto clear_fp;
    }
#endif // TO_SIMD_SFX
#ifndef NPY_DISABLE_OPTIMIZATION
    // Note, 4x unroll was chosen for best results on Apple M1
    {
        npy_intp elemPerLoop = 4;
        for (; (i+elemPerLoop) <= len; i += elemPerLoop) {
            /**begin repeat1
             * #unroll = 0, 1, 2, 3#
             */
            @type@ v@unroll@ = *((@type@ *)(ip1 + (i + @unroll@) * is1));
            @type@ u@unroll@ = *((@type@ *)(ip2 + (i + @unroll@) * is2));
            *((@type@ *)(op1 + (i + @unroll@) * os1)) = scalar_min_@scalar_sfx@(v@unroll@, u@unroll@);
            *((@type@ *)(op2 + (i + @unroll@) * os2)) = scalar_max_@scalar_sfx@(v@unroll@, u@unroll@);
            /**end repeat1**/
        }
    }
#endif // NPY_DISABLE_OPTIMIZATION
    ip1 += is1 * i;
    ip2 += is2 * i;
    op1 += os1 * i;
    op2 += os2 * i;
    for (; i < len; ++i, ip1 += is1, ip2 += is2, op1 += os1, op2 += os2) {
        const @type@ in1 = *(@type@ *)ip1;
        const @type@ in2 = *(@type@ *)ip2;
        *((@type@ *)op1) = scalar_min_@scalar_sfx@(in1, in2);
        *((@type@ *)op2) = scalar_max_@scalar_sfx@(in1, in2);
    }
#ifdef TO_SIMD_SFX
clear_fp:
    npyv_cleanup();
#endif
#if @is_fp@
    npy_clear_floatstatus_barrier((char*)dimensions);
#endif
}

/*
 * Fused `minimummaximum` reduction loop, laid out as
 *     [acc_min, acc_max, x, out_min, out_max]
 * with out_i aliased to acc_i.
 */
NPY_NO_EXPORT int NPY_CPU_DISPATCH_CURFX(@TYPE@_minimummaximum_reduce)
(PyArrayMethod_Context *NPY_UNUSED(context), char *const *data,
 npy_intp const *dimensions, npy_intp const *strides, NpyAuxData *NPY_UNUSED(auxdata))
{
    npy_intp n = dimensions[0];
    const npy_intp elsize = (npy_intp)sizeof(@type@);
#ifdef TO_SIMD_SFX
    #undef STYPE
    #define STYPE TO_SIMD_SFX(npyv_lanetype)
    // reducing over the contiguous axis: the accumulators are scalars
    if (strides[0] == 0 && strides[1] == 0 && strides[3] == 0 && strides[4] == 0
            && strides[2] == elsize) {
        TO_SIMD_SFX(simd_reduce_c_minmax)(
            (const STYPE*)data[2], (STYPE*)data[3], (STYPE*)data[4], n);
        goto done;
    }
    // reducing over an outer axis: accumulators are contiguous arrays
    if (strides[0] == elsize && strides[1] == elsize && strides[2] == elsize
            && strides[3] == elsize && strides[4] == elsize) {
        TO_SIMD_SFX(simd_reduce_outer_minmax)(
            (const STYPE*)data[2], (STYPE*)data[3], (STYPE*)data[4], n);
        goto done;
    }
#endif // TO_SIMD_SFX
    {
        // generic strided fallback (also the only path without SIMD)
        char *acc_min = data[0], *acc_max = data[1], *x = data[2];
        char *out_min = data[3], *out_max = data[4];
        for (npy_intp k = 0; k < n; k++) {
            const @type@ v = *(const @type@ *)x;
            *(@type@ *)out_min = scalar_min_@scalar_sfx@(*(const @type@ *)acc_min, v);
            *(@type@ *)out_max = scalar_max_@scalar_sfx@(*(const @type@ *)acc_max, v);
            acc_min += strides[0]; acc_max += strides[1]; x += strides[2];
            out_min += strides[3]; out_max += strides[4];
        }
    }
#ifdef TO_SIMD_SFX
done:
    npyv_cleanup();
#endif
#if @is_fp@
    npy_clear_floatstatus_barrier((char*)dimensions);
#endif
    return 0;
}
/**end repeat**/
