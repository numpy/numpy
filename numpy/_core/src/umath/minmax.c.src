/*
 * Fused `minimummaximum` support for the dtypes that are not handled by the
 * SIMD loops in loops_minmax.dispatch.c.src (bool, float16, complex,
 * datetime64/timedelta64 and object), plus the registration of the reduction
 * loop for *every* supported dtype.
 *
 * The SIMD dtypes (all integers + float32/64/longdouble) have their forward
 * and reduction loops generated in loops_minmax.dispatch.c.src; here we only
 * add the remaining scalar loops and the `get_reduction_loop` glue that binds
 * each dtype's ArrayMethod to its reduction loop.
 */
#define NPY_NO_DEPRECATED_API NPY_API_VERSION
#define _MULTIARRAYMODULE
#define _UMATHMODULE

#include <Python.h>

#include "numpy/ndarraytypes.h"
#include "numpy/halffloat.h"
#include "numpy/npy_math.h"
#include "numpy/ufuncobject.h"

#include "npy_cpu_dispatch.h"
#include "array_method.h"
#include "dispatching.h"
#include "dtypemeta.h"
#include "fast_loop_macros.h"

#include "minmax.h"

/* NaN-propagating, lexicographic complex comparisons (as in loops.c.src) */
#define CGE(xr, xi, yr, yi) ((xr > yr && !npy_isnan(xi) && !npy_isnan(yi)) \
                             || (xr == yr && xi >= yi))
#define CLE(xr, xi, yr, yi) ((xr < yr && !npy_isnan(xi) && !npy_isnan(yi)) \
                             || (xr == yr && xi <= yi))


/*
 * ------------------------------- forward loops ---------------------------
 * op_min = minimum(x1, x2), op_max = maximum(x1, x2), one pass.  These use the
 * legacy loop signature and are registered through generate_umath.py, exactly
 * like the per-dtype `minimum`/`maximum` scalar loops.
 */

NPY_NO_EXPORT void
BOOL_minimummaximum(char **args, npy_intp const *dimensions,
                    npy_intp const *steps, void *NPY_UNUSED(func))
{
    BINARY_LOOP_TWO_OUT {
        const npy_bool in1 = *(npy_bool *)ip1;
        const npy_bool in2 = *(npy_bool *)ip2;
        *((npy_bool *)op1) = in1 && in2;
        *((npy_bool *)op2) = in1 || in2;
    }
}

NPY_NO_EXPORT void
HALF_minimummaximum(char **args, npy_intp const *dimensions,
                    npy_intp const *steps, void *NPY_UNUSED(func))
{
    BINARY_LOOP_TWO_OUT {
        const npy_half in1 = *(npy_half *)ip1;
        const npy_half in2 = *(npy_half *)ip2;
        *((npy_half *)op1) =
                (npy_half_le(in1, in2) || npy_half_isnan(in1)) ? in1 : in2;
        *((npy_half *)op2) =
                (npy_half_ge(in1, in2) || npy_half_isnan(in1)) ? in1 : in2;
    }
    /* npy_half_isnan will never set floatstatus_invalid, so do not clear */
}

/**begin repeat
 * #TYPE = CFLOAT, CDOUBLE, CLONGDOUBLE#
 * #ftype = npy_float, npy_double, npy_longdouble#
 */
NPY_NO_EXPORT void
@TYPE@_minimummaximum(char **args, npy_intp const *dimensions,
                      npy_intp const *steps, void *NPY_UNUSED(func))
{
    BINARY_LOOP_TWO_OUT {
        const @ftype@ in1r = ((@ftype@ *)ip1)[0];
        const @ftype@ in1i = ((@ftype@ *)ip1)[1];
        const @ftype@ in2r = ((@ftype@ *)ip2)[0];
        const @ftype@ in2i = ((@ftype@ *)ip2)[1];
        const int nan1 = npy_isnan(in1r) || npy_isnan(in1i);
        if (nan1 || CLE(in1r, in1i, in2r, in2i)) {
            ((@ftype@ *)op1)[0] = in1r; ((@ftype@ *)op1)[1] = in1i;
        }
        else {
            ((@ftype@ *)op1)[0] = in2r; ((@ftype@ *)op1)[1] = in2i;
        }
        if (nan1 || CGE(in1r, in1i, in2r, in2i)) {
            ((@ftype@ *)op2)[0] = in1r; ((@ftype@ *)op2)[1] = in1i;
        }
        else {
            ((@ftype@ *)op2)[0] = in2r; ((@ftype@ *)op2)[1] = in2i;
        }
    }
    npy_clear_floatstatus_barrier((char*)dimensions);
}
/**end repeat**/

/**begin repeat
 * #TYPE = DATETIME, TIMEDELTA#
 * #type = npy_datetime, npy_timedelta#
 */
NPY_NO_EXPORT void
@TYPE@_minimummaximum(char **args, npy_intp const *dimensions,
                      npy_intp const *steps, void *NPY_UNUSED(func))
{
    BINARY_LOOP_TWO_OUT {
        const @type@ in1 = *(@type@ *)ip1;
        const @type@ in2 = *(@type@ *)ip2;
        @type@ lo, hi;
        if (in1 == NPY_DATETIME_NAT) {
            lo = in1; hi = in1;
        }
        else if (in2 == NPY_DATETIME_NAT) {
            lo = in2; hi = in2;
        }
        else {
            lo = (in1 < in2) ? in1 : in2;
            hi = (in1 > in2) ? in1 : in2;
        }
        *((@type@ *)op1) = lo;
        *((@type@ *)op2) = hi;
    }
}
/**end repeat**/

static inline PyObject *
minmax_object_min(PyObject *a, PyObject *b)
{
    int cmp = PyObject_RichCompareBool(a, b, Py_LE);
    if (cmp < 0) {
        return NULL;
    }
    PyObject *r = cmp ? a : b;
    Py_INCREF(r);
    return r;
}

static inline PyObject *
minmax_object_max(PyObject *a, PyObject *b)
{
    int cmp = PyObject_RichCompareBool(a, b, Py_GE);
    if (cmp < 0) {
        return NULL;
    }
    PyObject *r = cmp ? a : b;
    Py_INCREF(r);
    return r;
}

NPY_NO_EXPORT void
OBJECT_minimummaximum(char **args, npy_intp const *dimensions,
                      npy_intp const *steps, void *NPY_UNUSED(func))
{
    BINARY_LOOP_TWO_OUT {
        PyObject *a = *(PyObject **)ip1, *b = *(PyObject **)ip2;
        if (a == NULL) a = Py_None;
        if (b == NULL) b = Py_None;
        PyObject *lo = minmax_object_min(a, b);
        PyObject *hi = lo != NULL ? minmax_object_max(a, b) : NULL;
        if (lo == NULL || hi == NULL) {
            Py_XDECREF(lo);
            Py_XDECREF(hi);
            return;
        }
        Py_XSETREF(*(PyObject **)op1, lo);
        Py_XSETREF(*(PyObject **)op2, hi);
    }
}


/*
 * ------------------------------ reduction loops --------------------------
 * Layout is [acc_min, acc_max, x, out_min, out_max] with out_i aliased to
 * acc_i.  Read the accumulators before writing the (aliased) outputs.
 */

static int
BOOL_minimummaximum_reduce(PyArrayMethod_Context *NPY_UNUSED(context),
        char *const data[], npy_intp const dimensions[],
        npy_intp const strides[], NpyAuxData *NPY_UNUSED(auxdata))
{
    npy_intp n = dimensions[0];
    char *acc_min = data[0], *acc_max = data[1], *x = data[2];
    char *out_min = data[3], *out_max = data[4];
    for (npy_intp k = 0; k < n; k++) {
        const npy_bool v = *(npy_bool *)x;
        *(npy_bool *)out_min = (*(npy_bool *)acc_min) && v;
        *(npy_bool *)out_max = (*(npy_bool *)acc_max) || v;
        acc_min += strides[0]; acc_max += strides[1]; x += strides[2];
        out_min += strides[3]; out_max += strides[4];
    }
    return 0;
}

static int
HALF_minimummaximum_reduce(PyArrayMethod_Context *NPY_UNUSED(context),
        char *const data[], npy_intp const dimensions[],
        npy_intp const strides[], NpyAuxData *NPY_UNUSED(auxdata))
{
    npy_intp n = dimensions[0];
    char *acc_min = data[0], *acc_max = data[1], *x = data[2];
    char *out_min = data[3], *out_max = data[4];
    for (npy_intp k = 0; k < n; k++) {
        const npy_half v = *(npy_half *)x;
        const npy_half cmin = *(npy_half *)acc_min;
        const npy_half cmax = *(npy_half *)acc_max;
        *(npy_half *)out_min =
                (npy_half_le(cmin, v) || npy_half_isnan(cmin)) ? cmin : v;
        *(npy_half *)out_max =
                (npy_half_ge(cmax, v) || npy_half_isnan(cmax)) ? cmax : v;
        acc_min += strides[0]; acc_max += strides[1]; x += strides[2];
        out_min += strides[3]; out_max += strides[4];
    }
    return 0;
}

/**begin repeat
 * #TYPE = CFLOAT, CDOUBLE, CLONGDOUBLE#
 * #ftype = npy_float, npy_double, npy_longdouble#
 */
static int
@TYPE@_minimummaximum_reduce(PyArrayMethod_Context *NPY_UNUSED(context),
        char *const data[], npy_intp const dimensions[],
        npy_intp const strides[], NpyAuxData *NPY_UNUSED(auxdata))
{
    npy_intp n = dimensions[0];
    char *acc_min = data[0], *acc_max = data[1], *x = data[2];
    char *out_min = data[3], *out_max = data[4];
    for (npy_intp k = 0; k < n; k++) {
        const @ftype@ vr = ((@ftype@ *)x)[0];
        const @ftype@ vi = ((@ftype@ *)x)[1];
        const @ftype@ ar = ((@ftype@ *)acc_min)[0];
        const @ftype@ ai = ((@ftype@ *)acc_min)[1];
        const @ftype@ br = ((@ftype@ *)acc_max)[0];
        const @ftype@ bi = ((@ftype@ *)acc_max)[1];
        if (npy_isnan(ar) || npy_isnan(ai) || CLE(ar, ai, vr, vi)) {
            ((@ftype@ *)out_min)[0] = ar; ((@ftype@ *)out_min)[1] = ai;
        }
        else {
            ((@ftype@ *)out_min)[0] = vr; ((@ftype@ *)out_min)[1] = vi;
        }
        if (npy_isnan(br) || npy_isnan(bi) || CGE(br, bi, vr, vi)) {
            ((@ftype@ *)out_max)[0] = br; ((@ftype@ *)out_max)[1] = bi;
        }
        else {
            ((@ftype@ *)out_max)[0] = vr; ((@ftype@ *)out_max)[1] = vi;
        }
        acc_min += strides[0]; acc_max += strides[1]; x += strides[2];
        out_min += strides[3]; out_max += strides[4];
    }
    return 0;
}
/**end repeat**/

/**begin repeat
 * #TYPE = DATETIME, TIMEDELTA#
 * #type = npy_datetime, npy_timedelta#
 */
static int
@TYPE@_minimummaximum_reduce(PyArrayMethod_Context *NPY_UNUSED(context),
        char *const data[], npy_intp const dimensions[],
        npy_intp const strides[], NpyAuxData *NPY_UNUSED(auxdata))
{
    npy_intp n = dimensions[0];
    char *acc_min = data[0], *acc_max = data[1], *x = data[2];
    char *out_min = data[3], *out_max = data[4];
    for (npy_intp k = 0; k < n; k++) {
        const @type@ v = *(@type@ *)x;
        const @type@ cmin = *(@type@ *)acc_min;
        const @type@ cmax = *(@type@ *)acc_max;
        @type@ lo, hi;
        if (cmin == NPY_DATETIME_NAT) { lo = cmin; }
        else if (v == NPY_DATETIME_NAT) { lo = v; }
        else { lo = (cmin < v) ? cmin : v; }
        if (cmax == NPY_DATETIME_NAT) { hi = cmax; }
        else if (v == NPY_DATETIME_NAT) { hi = v; }
        else { hi = (cmax > v) ? cmax : v; }
        *(@type@ *)out_min = lo;
        *(@type@ *)out_max = hi;
        acc_min += strides[0]; acc_max += strides[1]; x += strides[2];
        out_min += strides[3]; out_max += strides[4];
    }
    return 0;
}
/**end repeat**/

static int
OBJECT_minimummaximum_reduce(PyArrayMethod_Context *NPY_UNUSED(context),
        char *const data[], npy_intp const dimensions[],
        npy_intp const strides[], NpyAuxData *NPY_UNUSED(auxdata))
{
    npy_intp n = dimensions[0];
    char *acc_min = data[0], *acc_max = data[1], *x = data[2];
    char *out_min = data[3], *out_max = data[4];
    for (npy_intp k = 0; k < n; k++) {
        PyObject *cur_min = *(PyObject **)acc_min;
        PyObject *cur_max = *(PyObject **)acc_max;
        PyObject *val = *(PyObject **)x;
        if (cur_min == NULL) cur_min = Py_None;
        if (cur_max == NULL) cur_max = Py_None;
        if (val == NULL) val = Py_None;
        PyObject *lo = minmax_object_min(cur_min, val);
        PyObject *hi = lo != NULL ? minmax_object_max(cur_max, val) : NULL;
        if (lo == NULL || hi == NULL) {
            Py_XDECREF(lo);
            Py_XDECREF(hi);
            return -1;
        }
        Py_XSETREF(*(PyObject **)out_min, lo);
        Py_XSETREF(*(PyObject **)out_max, hi);
        acc_min += strides[0]; acc_max += strides[1]; x += strides[2];
        out_min += strides[3]; out_max += strides[4];
    }
    return 0;
}

#undef CGE
#undef CLE


/*
 * ---------------------------- registration glue --------------------------
 */

/*
 * One `get_reduction_loop` for every dtype: the SIMD dtypes return the
 * best-target loop from loops_minmax.dispatch.c.src; the scalar dtypes return
 * the loops above.
 */
static int
minimummaximum_get_reduction_loop(
        PyArrayMethod_Context *context,
        int NPY_UNUSED(aligned), int NPY_UNUSED(move_references),
        const npy_intp *NPY_UNUSED(strides),
        PyArrayMethod_StridedLoop **out_loop,
        NpyAuxData **out_transferdata,
        NPY_ARRAYMETHOD_FLAGS *flags)
{
    PyArrayMethod_StridedLoop *loop = NULL;
    NPY_ARRAYMETHOD_FLAGS f = NPY_METH_NO_FLOATINGPOINT_ERRORS;

    switch (context->descriptors[0]->type_num) {
    /**begin repeat
     * #TYPE = BYTE, UBYTE, SHORT, USHORT, INT, UINT,
     *         LONG, ULONG, LONGLONG, ULONGLONG,
     *         FLOAT, DOUBLE, LONGDOUBLE#
     */
        case NPY_@TYPE@:
            NPY_CPU_DISPATCH_CALL(loop = @TYPE@_minimummaximum_reduce);
            break;
    /**end repeat**/
        case NPY_BOOL: loop = &BOOL_minimummaximum_reduce; break;
        case NPY_HALF: loop = &HALF_minimummaximum_reduce; break;
    /**begin repeat
     * #TYPE = CFLOAT, CDOUBLE, CLONGDOUBLE#
     */
        case NPY_@TYPE@: loop = &@TYPE@_minimummaximum_reduce; break;
    /**end repeat**/
        case NPY_DATETIME: loop = &DATETIME_minimummaximum_reduce; break;
        case NPY_TIMEDELTA: loop = &TIMEDELTA_minimummaximum_reduce; break;
        case NPY_OBJECT:
            loop = &OBJECT_minimummaximum_reduce;
            f = NPY_METH_REQUIRES_PYAPI;
            break;
        default:
            PyErr_SetString(PyExc_RuntimeError,
                    "minimummaximum reduction: unsupported dtype");
            return -1;
    }
    *out_loop = loop;
    *out_transferdata = NULL;
    *flags = f;
    return 0;
}


NPY_NO_EXPORT int
init_minimummaximum(PyObject *umath)
{
    static const int typenums[] = {
        NPY_BOOL,
        NPY_BYTE, NPY_UBYTE, NPY_SHORT, NPY_USHORT, NPY_INT, NPY_UINT,
        NPY_LONG, NPY_ULONG, NPY_LONGLONG, NPY_ULONGLONG,
        NPY_HALF, NPY_FLOAT, NPY_DOUBLE, NPY_LONGDOUBLE,
        NPY_CFLOAT, NPY_CDOUBLE, NPY_CLONGDOUBLE,
        NPY_DATETIME, NPY_TIMEDELTA,
        NPY_OBJECT,
    };

    PyUFuncObject *ufunc =
            (PyUFuncObject *)PyDict_GetItemString(umath, "minimummaximum");
    if (ufunc == NULL) {
        PyErr_SetString(PyExc_RuntimeError,
                "internal NumPy error: minimummaximum ufunc not found");
        return -1;
    }

    for (size_t k = 0; k < sizeof(typenums) / sizeof(typenums[0]); k++) {
        PyArray_DTypeMeta *dt = PyArray_DTypeFromTypeNum(typenums[k]);
        if (dt == NULL) {
            return -1;
        }
        PyObject *info = get_info_no_cast(ufunc, dt, 4);
        Py_DECREF(dt);
        if (info == NULL) {
            return -1;
        }
        if (info == Py_None || !PyObject_TypeCheck(info, &PyArrayMethod_Type)) {
            PyErr_SetString(PyExc_RuntimeError,
                    "internal NumPy error: minimummaximum loop not found");
            return -1;
        }
        /*
         * `minimummaximum` is reorderable (like `minimum`/`maximum`), but the
         * legacy ArrayMethod only sets that flag for nin==2/nout==1 loops, so
         * set it here to allow multi-axis reductions.
         */
        ((PyArrayMethodObject *)info)->flags |= NPY_METH_IS_REORDERABLE;
        ((PyArrayMethodObject *)info)->get_reduction_loop =
                &minimummaximum_get_reduction_loop;
    }

    return 0;
}
